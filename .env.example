# Offline by default: the demo data is already generated. Set to 1 (with the keys below) to run new generations.
DEMO_LIVE=

# Managed providers
FAL_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Which text/vision model runs DNA extraction, QA and copy: "gemini" or "local-llm"
TEXT_MODEL=gemini

# Self-hosted: any OpenAI-compatible server (vLLM, Ollama, LM Studio) with a vision model
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=
OPENAI_MODEL=qwen3-vl

# ComfyUI pod on RunPod: Qwen Image 2.1 and Pixal3D (images and 3D)
COMFY_BASE=https://<pod-id>-8188.proxy.runpod.net

# Demo: the operator pass prepared beforehand, a GLB with operator.json next to it (default: demo/operator/cabas.glb)
DEMO_OPERATOR_GLB=

# Market test: the reading of the simulated campaign runs on Amazon Bedrock (Converse API).
# Credentials come from the default AWS chain: AWS_PROFILE, env keys or SSO.
AWS_PROFILE=
AWS_REGION=eu-central-1
BEDROCK_MODEL_ID=eu.anthropic.claude-sonnet-5-5
# Text model for the market-test analysis: "bedrock" (default), "gemini" or "local-llm"
CAMPAIGN_TEXT_MODEL=bedrock
# 1 lets the market-test analysis call the LLM while the rest of the demo stays offline
CAMPAIGN_LLM=1
